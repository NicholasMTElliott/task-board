{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "llama-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Qwen3.6 (llama-server)",
      "options": {
        "baseURL": "${OPENCODE_PROVIDER_BASE_URL}",
        "apiKey": "${OPENCODE_AUTH_TOKEN}"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B (no thinking)",
          "limit": { "context": 131072, "output": 8192 }
        },
        "qwen3.6-35b-a3b-think": {
          "name": "Qwen3.6 35B-A3B (thinking)",
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    }
  },
  "model": "llama-server/${OPENCODE_MODEL_NAME}",
  "small_model": "llama-server/qwen3.6-35b-a3b-think",
  "compaction": {
    "auto": true,
    "prune": true
  }
}
