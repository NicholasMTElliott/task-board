<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>aiboard</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TaskBoard.Worker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <!-- Restore implicit usings that were provided by Microsoft.NET.Sdk.Web -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\workflow.v1.json" CopyToOutputDirectory="PreserveNewest" Link="workflow.v1.json" />
    <Content Include="..\..\..\workflow.github.example.json" CopyToOutputDirectory="PreserveNewest" Link="workflow.github.example.json" />
    <Content Include="..\..\..\workflow.simple.example.json" CopyToOutputDirectory="PreserveNewest" Link="workflow.simple.example.json" />
    <Content Include="..\..\..\workflow.story-decomposition.example.json" CopyToOutputDirectory="PreserveNewest" Link="workflow.story-decomposition.example.json" />
    <Content Include="..\..\..\prompts\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="prompts" />
    <Content Include="..\..\..\templates\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="templates" />
    <Content Include="..\..\..\skills\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="skills" />
    <Content Include="..\..\..\QUICKSTART.md" CopyToOutputDirectory="PreserveNewest" Link="QUICKSTART.md" />
    <Content Include="..\..\..\Agent.md" CopyToOutputDirectory="PreserveNewest" Link="Agent.md" />
    <!-- Ship end-user docs only. Legacy/dev-only docs (CliVersionTesting,
         Deployment, local-webhook-smoke, prototype-config, pgmq-neon-spike-results,
         PublishTrimmedSpike) reference scripts/ and lambda/src/ that aren't in
         the install, or document forward-looking spikes intended for repo
         readers only. -->
    <Content Include="..\..\..\docs\**\*.md" CopyToOutputDirectory="PreserveNewest" LinkBase="docs"
             Exclude="..\..\..\docs\CliVersionTesting.md;..\..\..\docs\Deployment.md;..\..\..\docs\local-webhook-smoke.md;..\..\..\docs\prototype-config.md;..\..\..\docs\pgmq-neon-spike-results.md;..\..\..\docs\PublishTrimmedSpike.md" />
    <Content Include="..\..\..\appsettings.user.example.json" CopyToOutputDirectory="PreserveNewest" Link="appsettings.user.example.json" />
    <Content Include="..\..\..\docker-compose.yml" CopyToOutputDirectory="PreserveNewest" Link="docker-compose.yml" />
    <Content Include="..\..\..\db\migrations\*.sql" CopyToOutputDirectory="PreserveNewest" LinkBase="db\migrations" />
    <!-- Sandbox build scripts and Dockerfiles — referenced by docs/*Sandbox.md. -->
    <Content Include="..\..\..\scripts\build-sandbox.ps1" CopyToOutputDirectory="PreserveNewest" Link="scripts\build-sandbox.ps1" />
    <Content Include="..\..\..\scripts\build-codex-sandbox.ps1" CopyToOutputDirectory="PreserveNewest" Link="scripts\build-codex-sandbox.ps1" />
    <Content Include="..\..\..\scripts\build-opencode-sandbox.ps1" CopyToOutputDirectory="PreserveNewest" Link="scripts\build-opencode-sandbox.ps1" />
    <Content Include="..\..\..\docker\agent-sandbox\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="docker\agent-sandbox" />
    <Content Include="..\..\..\docker\codex-sandbox\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="docker\codex-sandbox" />
    <Content Include="..\..\..\docker\opencode-sandbox\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="docker\opencode-sandbox" />
  </ItemGroup>

</Project>
