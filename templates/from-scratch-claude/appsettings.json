{
  "Mode": "polling",
  "BoardProvider": "github",
  "AgentExecutor": "docker-claude-cli",
  "AgentWorkspacePath": ".",
  "WorktreeBasePath": "../worktrees",
  "WorkflowConfigPath": ".aiboard/workflow.json",

  "ClaudeCli":     { "TimeoutSeconds": 1800 },
  "DockerAgents":  {
    "Claude": { "TimeoutSeconds": 1800 }
  },

  "GitHubProjects": {
    "Owner":         "__OWNER__",
    "Repo":          "__OWNER_SLASH_REPO__",
    "ProjectNumber": "__PROJECT_NUMBER__"
  }
}
