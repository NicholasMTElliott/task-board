# ============================================================
# AI Board — Environment Variable Reference
# ============================================================
# These override values in appsettings.json (standard .NET config hierarchy).
# For local development, prefer appsettings.user.json instead.
# See appsettings.user.example.json for a template.
# ============================================================

# Board provider: github | trello | stub
BoardProvider=github

# Agent executor: claude-cli | stub
AgentExecutor=claude-cli

# Path to workflow configuration file (absolute or relative to CWD)
WorkflowConfigPath=./workflow.github.json

# --- GitHub Projects Configuration ---
GitHubProjects__Owner=
GitHubProjects__Repo=
GitHubProjects__ProjectNumber=

# --- Claude CLI Configuration (optional overrides) ---
# ClaudeCli__ExecutablePath=claude
# ClaudeCli__MaxBudgetUsd=10.00
# ClaudeCli__TimeoutSeconds=900

# --- Trello Configuration (if using BoardProvider=trello) ---
# Trello__ApiKey=
# Trello__ApiToken=
# Trello__BaseUrl=https://api.trello.com

# --- Runtime Configuration (optional, also settable via CLI args) ---
# BoardId=1
# AgentWorkspacePath=.
# PollIntervalSeconds=60
# WorktreeBasePath=
